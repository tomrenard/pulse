{
  "name": "pulse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm worker && next dev",
    "build": "pnpm worker && next build",
    "start": "next start",
    "lint": "biome check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types scripts/migrate.ts",
    "worker": "node -e \"require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.mjs')\""
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
