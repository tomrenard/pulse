# Neon pooled URL (set by the Vercel Neon integration)
DATABASE_URL=
# The one login password, and the key that signs the session cookie (openssl rand -base64 32)
APP_PASSWORD=
SESSION_SECRET=
# Local dev with a single-connection database (pglite-server): 1
# DB_POOL_MAX=
# intervals.icu API key and athlete id (Settings → Developer)
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=
# Vercel sends it as "Bearer CRON_SECRET" to /api/cron/sync (openssl rand -hex 24)
CRON_SECRET=
